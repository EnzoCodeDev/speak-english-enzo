{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	respond /health 200
	# El reconocimiento de voz necesita el micrófono de este mismo origen
	header Permissions-Policy "microphone=(self)"
	# Los assets de Next llevan hash en el nombre: se pueden cachear para siempre.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	# El HTML siempre se revalida para no mezclar versiones.
	@html not path /_next/static/*
	header @html Cache-Control "no-cache"
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
